# 复制为 .env 后填入。
#
# 通义千问（阿里云百炼）—— 全流程使用，按环节选型见 core/llm.py 的 Provider.task_models
# 申请：https://bailian.console.aliyun.com/ 开通后在「API-KEY」页面创建
DASHSCOPE_API_KEY=

# 可选：切换供应商。默认 qwen。
# 注意 DeepSeek 官方 API 无视觉能力，视觉转写环节必须用 qwen。
# LLM_PROVIDER=qwen

# 可选：更换分析目标站点。默认取 core/config.py 里的 SITE_BASE。
# 换站后需重跑：python -m website.fetch && python -m website.chunk
#              && python -m retrieval.build_index -c site
# SITE_BASE=https://example.com/
